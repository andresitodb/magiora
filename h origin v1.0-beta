[32m+[m
[32m+[m[32mtest('profile fields are grouped into the six editorial chapters', () => {[m
[32m+[m[32m  assert.deepEqual(PROFILE_CHAPTERS.map((chapter) => chapter.label), [[m
[32m+[m[32m    'Profile essentials',[m
[32m+[m[32m    'Professional practice',[m
[32m+[m[32m    'Work',[m
[32m+[m[32m    'Contact',[m
[32m+[m[32m    'Public presence',[m
[32m+[m[32m    'Trust & account',[m
[32m+[m[32m  ]);[m
[32m+[m
[32m+[m[32m  const progress = getChapterProgress(computeDashboardCompleteness({[m
[32m+[m[32m    display_name: 'Ava Stone',[m
[32m+[m[32m    role_titles: ['Actor'],[m
[32m+[m[32m  }));[m
[32m+[m[32m  assert.deepEqual(progress.map(({ id, total }) => [id, total]), [[m
[32m+[m[32m    ['profile-essentials', 5],[m
[32m+[m[32m    ['professional-practice', 2],[m
[32m+[m[32m    ['work', 2],[m
[32m+[m[32m    ['contact-chapter', 1],[m
[32m+[m[32m    ['public-presence', 0],[m
[32m+[m[32m    ['trust-account', 0],[m
[32m+[m[32m  ]);[m
[32m+[m[32m  assert.equal(progress[0].completed, 2);[m
[32m+[m[32m  assert.equal(progress[0].percent, 40);[m
[32m+[m[32m});[m
[32m+[m
[32m+[m[32mtest('public profile status uses approved and visible without introducing another state', () => {[m
[32m+[m[32m  assert.equal(getProfilePublicStatus(true, true), 'Public');[m
[32m+[m[32m  assert.equal(getProfilePublicStatus(false, true), 'Private');[m
[32m+[m[32m  assert.equal(getProfilePublicStatus(true, false), 'Awaiting approval');[m
[32m+[m[32m  assert.equal(getProfilePublicStatus(false, false), 'Awaiting approval');[m
[32m+[m[32m});[m
[32m+[m
[32m+[m[32mtest('dirty state tracks only main-form changes and excludes auto-saved media', () => {[m
[32m+[m[32m  assert.equal(shouldTrackProfileChange({ formId: 'profile-form', autoSaved: false }), true);[m
[32m+[m[32m  assert.equal(shouldTrackProfileChange({ formId: 'profile-form', autoSaved: true }), false);[m
[32m+[m[32m  assert.equal(shouldTrackProfileChange({ formId: 'password-form', autoSaved: false }), false);[m
[32m+[m[32m});[m
[32m+[m
[32m+[m[32mtest('sticky save warning ignores chapter navigation and successful submission', () => {[m
[32m+[m[32m  assert.equal(shouldWarnForUnsavedChanges({ dirty: true, submitting: false, destination: '/dashboard' }), true);[m
[32m+[m[32m  assert.equal(shouldWarnForUnsavedChanges({ dirty: true, submitting: false, destination: '#work' }), false);[m
[32m+[m[32m  assert.equal(shouldWarnForUnsavedChanges({ dirty: true, submitting: true, destination: '/dashboard' }), false);[m
[32m+[m[32m  assert.equal(shouldWarnForUnsavedChanges({ dirty: false, submitting: false, destination: '/dashboard' }), false);[m
[32m+[m[32m});[m
[32m+[m
[32m+[m[32mtest('profile editor renders a sticky save region and marks media as auto-saved', () => {[m
[32m+[m[32m  const experienceSource = readFileSync([m
[32m+[m[32m    new URL('./src/components/ProfileEditorExperience.tsx', import.meta.url),[m
[32m+[m[32m    'utf8',[m
