[32m+[m[32m});[m
[32m+[m
[32m+[m[32mtest('validation summary maps errors to the most relevant profile section', () => {[m
[32m+[m[32m  assert.deepEqual(validationSummary('Demo reel must be a valid URL'), {[m
[32m+[m[32m    title: 'Your profile was not saved',[m
[32m+[m[32m    message: 'Demo reel must be a valid URL',[m
[32m+[m[32m    target: 'portfolio',[m
